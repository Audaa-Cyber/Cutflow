# Whisper model options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=10800
MAX_ACTIVE_JOBS=4
WHISPER_CPU_THREADS=2

# Persistent backend: one Docker instance with the named data volume.
# Set API_HOST to a DNS hostname pointed at your server; Caddy provides HTTPS.
CUTFLOW_API_HOST=
# Public origin consumed by the Vercel frontend build; no /api suffix.
CUTFLOW_API_URL=
CUTFLOW_ALLOWED_ORIGINS=https://cutflow-fawn.vercel.app
CUTFLOW_MAX_OWNER_ACTIVE_JOBS=2
CUTFLOW_MAX_OWNER_JOBS=100

# Optional OpenAI-compatible chat completions endpoint for prompt-driven clip ranking.
# Leave AI_BASE_URL and AI_API_KEY blank to use the heuristic ranking engine only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional backend backup storage. Use a PRIVATE Blob store and keep its token
# only on the Docker backend. SQLite/project state still uses the data volume.
# Leave blank for the simplest persistent Docker deployment.
BLOB_READ_WRITE_TOKEN=

# Set a Netscape cookies.txt export on the BACKEND, not the static frontend.
# Prefer a mounted private file; a valid session does not guarantee that YouTube
# accepts a cloud server's connection. Never commit or share the cookie value.
YOUTUBE_COOKIES=
# Container path of a mounted cookies file, or /app/data/.secrets/youtube-cookies.txt.
YOUTUBE_COOKIES_FILE=
# Optional supported client overrides; blank uses current yt-dlp defaults.
YOUTUBE_PLAYER_CLIENTS=
# Optional current yt-dlp PO token setting (client.context+token); operator only.
YOUTUBE_PO_TOKEN=
