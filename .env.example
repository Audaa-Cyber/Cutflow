# Whisper model options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=10800
MAX_ACTIVE_JOBS=4

# Optional OpenAI-compatible chat completions endpoint for prompt-driven clip ranking.
# Leave AI_BASE_URL and AI_API_KEY blank to use the heuristic ranking engine only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
