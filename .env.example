# Whisper model options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=10800
MAX_ACTIVE_JOBS=4

# Optional OpenAI-compatible chat completions endpoint for prompt-driven clip ranking.
# Leave AI_BASE_URL and AI_API_KEY blank to use the heuristic ranking engine only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Vercel Blob — set by `vercel storage create blob` or the Vercel Marketplace.
# When set, uploaded source files and rendered clips are stored in Blob so any
# container instance can access them. Leave blank for local/Docker deployments.
BLOB_READ_WRITE_TOKEN=

# YouTube cookies (Netscape cookies.txt format) — paste the full contents here
# to authenticate yt-dlp on cloud/datacenter IPs and bypass bot detection.
# Export from your browser using the "Get cookies.txt LOCALLY" extension while
# logged in to youtube.com, then set this in Vercel env vars (Production+Preview).
YOUTUBE_COOKIES=
